---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The requested page could not be found on Darshan Kansara's website.">
  <section class="not-found">
    <p class="code">404 · Signal lost</p>
    <h1>This path does not resolve.</h1>
    <p>The system is intact. The address is not.</p>
    <a href="/">Return to the main system <span aria-hidden="true">&rarr;</span></a>
  </section>
  <style>
    .not-found{min-height:calc(100vh - 100px);display:flex;flex-direction:column;justify-content:center;padding:var(--section) max(var(--pad),calc((100vw - var(--max))/2));border-bottom:1px solid var(--line)}
    .code{color:var(--gold);font:500 .68rem var(--font-mono);letter-spacing:.1em;text-transform:uppercase}
    h1{max-width:10ch;font-size:clamp(3.4rem,7vw,7rem);font-weight:400;line-height:.88}
    .not-found>p:not(.code){color:var(--muted);font-size:1.08rem}
    a{align-self:flex-start;margin-top:26px;padding:12px 17px;border:1px solid var(--line);color:var(--azure-bright);font-weight:500}
  </style>
</Base>