---
import Base from '../layouts/Base.astro';
const playUrl = 'https://play.google.com/store/apps/details?id=com.darshankansara.lifelens';
const webUrl = 'https://lifelens.darshankansara.com';
const privacyUrl = 'https://lifelens.darshankansara.com/privacy';
const screens = [
  ['/lifelens/screen-1.png', 'Library', 'LifeLens home screen with photo summary, cleanup action, and protected memory count'],
  ['/lifelens/screen-2.png', 'Storage', 'Ask LifeLens showing photo, video, WhatsApp, and screenshot storage totals'],
  ['/lifelens/screen-4.png', 'Collections', 'LifeLens collections for people, videos, WhatsApp media, and documents'],
  ['/lifelens/screen-5.png', 'Ask', 'Ask LifeLens search with suggested photo library questions and voice input'],
];
---
<Base title="LifeLens" description="LifeLens is a private Android photo intelligence app for understanding clutter, protecting memories, and reviewing cleanup without uploading your library." image="/lifelens/feature.png">
  <header class="product-hero">
    <div class="identity"><img src="/lifelens/icon.png" alt="" width="56" height="56" /><span>LifeLens</span><small><i></i>Live on Android</small></div>
    <div class="hero-copy"><p class="code">Private photo intelligence</p><h1>The library stays private.<br /><em>The decision stays yours.</em></h1><p>Find clutter, protect what matters, and ask questions about the photo library without uploading it into a LifeLens account or automating an irreversible choice.</p><nav><a class="primary" href={playUrl} target="_blank" rel="noopener noreferrer">Google Play ↗</a><a href={webUrl} target="_blank" rel="noopener noreferrer">Web analyzer ↗</a></nav><small>Android · English, Hindi, and Gujarati · No account required</small></div>
    <div class="hero-device"><span>Device / local</span><img src="/lifelens/screen-1.png" alt="LifeLens home screen showing a private photo library and review cleanup action" width="1080" height="2160" /></div>
  </header>
  <section class="contract" aria-label="LifeLens product contract"><p>Photos stay on device</p><p>Review before removal</p><p>Uncertain means protect</p><p>No account required</p></section>
  <section class="problem"><header><p class="code">01 / Product decision</p><h2>A camera roll is not a file system problem.</h2></header><div><p>It contains duplicates and screenshots, but also documents, relationships, and moments that cannot be recreated. LifeLens reduces the search space without pretending confidence where none exists.</p><blockquote>Smaller review groups. Visible evidence. No automatic deletion.</blockquote></div></section>
  <section class="capabilities" aria-label="LifeLens capabilities"><article><span>01</span><h3>Find the obvious waste.</h3><p>Exact duplicates, similar shots, bursts, screenshots, large videos, and messaging clutter become focused review groups.</p></article><article><span>02</span><h3>Protect before cleaning.</h3><p>Important documents and high-value memories stay away from casual cleanup. Low confidence favors protection.</p></article><article><span>03</span><h3>Ask the library.</h3><p>Text or voice questions use the library already indexed on the device to answer supported searches.</p></article><article><span>04</span><h3>Keep human control.</h3><p>Similar photos stay review-only. Destructive actions use Android confirmation. The owner makes the call.</p></article></section>
  <section class="screens"><header><p class="code">02 / Working interface</p><h2>Real screens, not a product promise.</h2></header><div>{screens.map(([src,label,alt]) => <figure><img src={src} alt={alt} width="1080" height="2160" loading="lazy" /><figcaption>{label}</figcaption></figure>)}</div></section>
  <section class="privacy"><header><p class="code">03 / Privacy architecture</p><h2>Your library is not the product.</h2><p>The Android app analyzes the photo library on the device. Visual labels and local indexes support retrieval; location searches use available photo metadata.</p><a href={privacyUrl} target="_blank" rel="noopener noreferrer">Privacy policy ↗</a></header><ol><li><span>01</span><strong>Your Android library</strong><small>Photos and videos already on the phone</small></li><li><span>02</span><strong>On-device analysis</strong><small>Groups, labels, and review suggestions</small></li><li><span>03</span><strong>Your decision</strong><small>Nothing removed without confirmation</small></li></ol></section>
  <section class="product-close"><img src="/lifelens/feature.png" alt="LifeLens. Free up space. Keep what matters." width="1024" height="500" loading="lazy" /><div><p class="code">Available now</p><h2>Understand the library before cleaning it.</h2><a href={playUrl} target="_blank" rel="noopener noreferrer">Open Google Play ↗</a></div></section>
  <style>
    :global(body),:global(main){background:var(--ink);color:var(--text)}.code,.identity small,.hero-copy>small,.hero-device span,.capabilities span,.screens figcaption,.privacy li span{font-family:var(--font-mono);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase}.code{color:var(--gold)}.product-hero,.contract,.problem,.capabilities,.screens,.privacy,.product-close{padding-inline:max(var(--pad),calc((100vw - var(--max))/2))}
    .product-hero{min-height:720px;display:grid;grid-template-columns:var(--rail) 1.15fr .7fr;gap:var(--gutter);align-items:center;border-bottom:1px solid var(--line);overflow:hidden}.identity{align-self:start;margin-top:74px;display:grid;grid-template-columns:56px 1fr;gap:4px 13px;align-items:center;color:var(--paper);font-family:var(--font-display);font-size:1.3rem}.identity img{grid-row:1/3;border-radius:7px}.identity small{color:var(--dim)}.identity i{display:inline-block;width:6px;height:6px;margin-right:7px;border-radius:50%;background:#42c98a}.hero-copy{padding-block:84px}.hero-copy h1{max-width:13ch;color:var(--paper);font-size:clamp(3.3rem,5.6vw,5.7rem);font-weight:400;line-height:.94}.hero-copy h1 em{color:var(--azure-bright);font-style:normal}.hero-copy>p:not(.code){max-width:57ch;color:var(--muted);font-size:1.06rem}.hero-copy nav{display:flex;gap:12px;margin:30px 0 14px}.hero-copy nav a{padding:11px 16px;border:1px solid var(--line);color:var(--paper);font-size:.84rem}.hero-copy nav .primary{background:var(--paper);color:var(--ink)}.hero-copy>small{color:var(--dim)}.hero-device{position:relative;align-self:end;height:620px;display:flex;align-items:flex-end;justify-content:center}.hero-device span{position:absolute;top:56px;right:0;color:var(--dim)}.hero-device img{width:min(100%,350px);height:auto;box-shadow:0 40px 90px rgba(0,0,0,.42)}
    .contract{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--line)}.contract p{min-height:86px;margin:0;padding:26px 18px;border-left:1px solid var(--line);color:var(--paper);font-size:.8rem}.contract p:last-child{border-right:1px solid var(--line)}.problem,.privacy{padding-block:var(--section);display:grid;grid-template-columns:var(--rail) 1fr;gap:var(--gutter);border-bottom:1px solid var(--line)}.problem header{display:contents}.problem h2,.screens h2,.privacy h2,.product-close h2{max-width:15ch;color:var(--paper);font-size:clamp(2.5rem,4.4vw,4.2rem);font-weight:400}.problem>div{grid-column:2;max-width:720px}.problem>div>p,.privacy header>p{color:var(--muted)}blockquote{margin:32px 0 0;padding-left:20px;border-left:2px solid var(--gold);color:var(--azure-bright);font-family:var(--font-display);font-size:1.35rem}.capabilities{display:grid;grid-template-columns:repeat(4,1fr);padding-block:var(--section)}.capabilities article{min-height:250px;padding:24px;border:1px solid var(--line);border-right:0;display:flex;flex-direction:column}.capabilities article:last-child{border-right:1px solid var(--line)}.capabilities span{color:var(--gold)}.capabilities h3{margin-top:auto;color:var(--paper);font:500 1rem var(--font-sans)}.capabilities p{color:var(--muted);font-size:.82rem}.screens{padding-block:var(--section);border-block:1px solid var(--line)}.screens header{display:grid;grid-template-columns:var(--rail) 1fr;gap:var(--gutter)}.screens>div{margin-top:58px;display:grid;grid-template-columns:repeat(4,1fr);gap:18px;align-items:start}.screens figure{margin:0}.screens figure:nth-child(even){margin-top:54px}.screens img{display:block;width:100%;height:auto;box-shadow:0 22px 56px rgba(0,0,0,.34)}.screens figcaption{padding-top:12px;color:var(--dim)}.privacy{grid-template-columns:.9fr 1.1fr}.privacy header{max-width:620px}.privacy header a{color:var(--azure-bright)}.privacy ol{list-style:none;margin:0;padding:26px;border:1px solid var(--line)}.privacy li{display:grid;grid-template-columns:42px 1fr;gap:2px 16px;padding:18px;border:1px solid var(--line)}.privacy li+li{margin-top:20px}.privacy li span{grid-row:1/3;color:var(--gold)}.privacy li strong{color:var(--paper)}.privacy li small{color:var(--dim)}.product-close{padding-block:var(--section);display:grid;grid-template-columns:1.1fr .9fr;gap:var(--gutter);align-items:center}.product-close img{border:1px solid var(--line)}.product-close a{color:var(--azure-bright)}
    @media(max-width:900px){.product-hero{grid-template-columns:130px 1fr}.hero-device{grid-column:2;height:520px}.contract,.capabilities{grid-template-columns:1fr 1fr}.privacy{grid-template-columns:1fr}.product-close{grid-template-columns:1fr}}@media(max-width:620px){.product-hero{grid-template-columns:1fr}.identity{margin-top:48px}.hero-copy{padding-block:28px}.hero-copy h1{font-size:clamp(2.8rem,12vw,3.7rem)}.hero-device{grid-column:auto;height:500px}.contract,.capabilities{grid-template-columns:1fr}.problem{grid-template-columns:1fr}.problem header{display:block}.problem>div{grid-column:auto}.screens header{grid-template-columns:1fr}.screens>div{grid-template-columns:1fr 1fr;gap:10px}.product-close{padding-block:80px}}
  </style>
</Base>
