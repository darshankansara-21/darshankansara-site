---
import Base from '../layouts/Base.astro';
import { site } from '../config';

const layers = [
  { era: '1998', name: 'Infrastructure', context: 'Servers, networks, operating systems', question: 'What is the machine actually doing?' },
  { era: '2005', name: 'Service operations', context: 'Availability, incidents, customer consequence', question: 'What happens when the service fails?' },
  { era: '2011', name: 'Datacenter + cloud', context: 'Instrumentation, automation, safe change', question: 'How do we learn before production?' },
  { era: '2020', name: 'Cloud operations', context: 'Capacity, supply, cost, continuous improvement', question: 'Where is pressure accumulating?' },
  { era: '2022', name: 'Data platform', context: 'Reliability, security, continuity, economics', question: 'Can everyone see the same system?' },
  { era: 'Now', name: 'AI-enabled operations', context: 'Telemetry, runbooks, bounded assistance', question: 'Which decision needs a better signal?' },
];

const records = [
  {
    id: '01', label: 'Cloud economics', signal: '$1M+', suffix: 'annual Azure platform savings',
    situation: 'Recurring infrastructure spend was growing faster than operational understanding.',
    intervention: 'Made cost an engineering signal: capacity, reservations, idle resources, automation, ownership.',
    consequence: 'Reduced annual platform spend while making the economics easier to operate.',
  },
  {
    id: '02', label: 'Reliability', signal: 'Pre-production', suffix: 'before global change',
    situation: 'Infrastructure changes carried uncertainty too close to live Azure datacenters.',
    intervention: 'Established the first Azure Datacenter Instrumentation & Pre-Production Lab.',
    consequence: 'Moved failure into a place designed for testing, instrumentation, and learning.',
  },
  {
    id: '03', label: 'Platform operations', signal: 'One view', suffix: 'across engineering and operations',
    situation: 'Reliability, security, privacy, continuity, and cost were managed as separate concerns.',
    intervention: 'Connected telemetry, readiness, ownership, and review around the same platform.',
    consequence: 'Made operational risk visible earlier and accountability less ambiguous.',
  },
];
---

<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-frame">
      <div class="hero-copy">
        <p class="identity"><span>Darshan Kansara</span><span>Senior Manager, Platform Reliability &amp; Operations</span><span>Microsoft · Redmond</span></p>
        <h1 id="hero-title">I learned technology where <em>failure is physical.</em></h1>
        <p class="hero-deck">That lesson still shapes how I operate cloud platforms, improve reliability, work with AI, and build products of my own.</p>
        <div class="hero-actions"><a href="#system">Trace the progression <span aria-hidden="true">↓</span></a><a href="#built">See what I build <span aria-hidden="true">→</span></a></div>
      </div>

      <figure class="signal-field" aria-labelledby="signal-caption">
        <svg viewBox="0 0 680 640" role="img" aria-label="A signal moving through infrastructure, cloud, data and operations toward an accountable decision">
          <g class="field-grid"><path d="M20 80H660M20 176H660M20 272H660M20 368H660M20 464H660M20 560H660"/><path d="M84 24V616M196 24V616M308 24V616M420 24V616M532 24V616M644 24V616"/></g>
          <path class="system-line" d="M70 520C122 486 128 402 194 390S272 430 322 352 376 214 446 236 506 318 550 224 582 120 630 92"/>
          <path class="signal-line" d="M70 520C122 486 128 402 194 390S272 430 322 352 376 214 446 236 506 318 550 224 582 120 630 92"/>
          <g class="field-nodes"><circle cx="70" cy="520" r="5"/><circle cx="194" cy="390" r="5"/><circle cx="322" cy="352" r="5"/><circle cx="446" cy="236" r="5"/><circle cx="550" cy="224" r="5"/><circle class="final-node" cx="630" cy="92" r="8"/></g>
          <g class="field-labels"><text x="42" y="550">physical</text><text x="160" y="420">service</text><text x="286" y="382">cloud</text><text x="410" y="266">data</text><text x="514" y="254">operations</text><text class="final-label" x="500" y="72">decision</text></g>
          <g class="field-notes"><text x="42" y="38">SYSTEM / SIGNAL / CONSEQUENCE</text><text x="42" y="600">1998</text><text x="602" y="600">NOW</text></g>
        </svg>
        <figcaption id="signal-caption">The abstractions changed. The need for evidence did not.</figcaption>
      </figure>
    </div>

    <div class="proof-line" aria-label="Career proof">
      <p><strong>25+ years</strong><span>from physical infrastructure to AI-enabled operations</span></p>
      <p><strong>Microsoft since 2011</strong><span>datacenter, cloud, continuous improvement, data platforms</span></p>
      <p><strong>Still shipping</strong><span>LifeLens and ApplyReady</span></p>
    </div>
  </section>

  <section id="system" class="system" aria-labelledby="system-title">
    <div class="system-heading">
      <p class="section-code">01 / The operating model</p>
      <div><h2 id="system-title">The technology changed.<br />The questions accumulated.</h2><p>A career is not a list of roles. It is a set of instincts earned one layer at a time. Each layer below still informs the one above it.</p></div>
    </div>

    <div class="layer-ledger">
      <div class="layer-spine" aria-hidden="true"><span></span></div>
      <ol>
        {layers.map((layer, index) => (
          <li style={`--step:${index}`}>
            <span class="layer-era">{layer.era}</span>
            <div class="layer-name"><small>Layer {String(index + 1).padStart(2, '0')}</small><h3>{layer.name}</h3></div>
            <p>{layer.context}</p>
            <blockquote>{layer.question}</blockquote>
          </li>
        ))}
      </ol>
    </div>
    <a class="route-link" href="/experience">Read the complete career story <span aria-hidden="true">→</span></a>
  </section>

  <section class="operator-builder" aria-labelledby="builder-contrast-title">
    <p class="section-code">02 / The useful contradiction</p>
    <div class="contrast-line"><p>Operate systems at scale.</p><span aria-hidden="true"></span><p>Still build from zero.</p></div>
    <h2 id="builder-contrast-title">The distance between those two keeps the judgment honest.</h2>
  </section>

  <section id="built" class="built" aria-labelledby="built-title">
    <header class="built-heading"><p class="section-code">03 / Built, not presented</p><div><h2 id="built-title">Two products. One operating principle.</h2><p>Expose the evidence. Protect the person. Keep the consequential decision in human hands.</p></div></header>

    <article class="product-story lifelens-story">
      <div class="product-copy">
        <p class="product-status"><span></span>Live on Android</p>
        <div class="product-title"><img src="/lifelens/icon.png" alt="" width="60" height="60" /><h3>LifeLens</h3></div>
        <p class="product-thesis">A private photo intelligence product for understanding clutter without surrendering the library.</p>
        <dl><div><dt>The problem</dt><dd>Photo libraries grow faster than people can understand them.</dd></div><div><dt>The boundary</dt><dd>Analysis stays on device. Uncertainty means protect. Deletion requires review.</dd></div><div><dt>The build</dt><dd>Flutter, on-device intelligence, Android, English, Hindi, and Gujarati.</dd></div></dl>
        <a href="/lifelens">Enter the LifeLens product story <span aria-hidden="true">→</span></a>
      </div>
      <div class="phone-stage" aria-label="LifeLens product screens">
        <img class="phone phone-one" src="/lifelens/screen-1.png" alt="LifeLens home screen showing a private photo library" width="1080" height="1920" loading="lazy" decoding="async" />
        <img class="phone phone-two" src="/lifelens/screen-2.png" alt="LifeLens storage analysis in plain language" width="1080" height="1920" loading="lazy" decoding="async" />
        <span>Real Android product</span>
      </div>
    </article>

    <article class="product-story applyready-story">
      <div class="apply-stage"><img src="/applyready/fit.png" alt="ApplyReady evidence-led role-fit comparison" width="1200" height="1200" loading="lazy" decoding="async" /><span>Real browser product</span></div>
      <div class="product-copy">
        <p class="product-status"><span></span>Live on the web</p>
        <div class="product-title"><i aria-hidden="true">AR</i><h3>ApplyReady</h3></div>
        <p class="product-thesis">A job-application workspace that asks whether the evidence supports applying before it starts rewriting.</p>
        <dl><div><dt>The problem</dt><dd>Most tools optimize the document before testing the fit.</dd></div><div><dt>The boundary</dt><dd>No invented experience, no account gate, no stored resume text.</dd></div><div><dt>The build</dt><dd>Deterministic browser-side analysis with editable application outputs.</dd></div></dl>
        <a href="/applyready">Enter the ApplyReady product story <span aria-hidden="true">→</span></a>
      </div>
    </article>
  </section>

  <section class="records" aria-labelledby="records-title">
    <header class="records-heading"><p class="section-code">04 / Operating records</p><h2 id="records-title">Evidence is what remains after the title is removed.</h2></header>
    <div class="record-list">
      {records.map((record) => (
        <article>
          <header><span>{record.id}</span><p>{record.label}</p></header>
          <div class="record-signal"><strong>{record.signal}</strong><small>{record.suffix}</small></div>
          <dl><div><dt>Situation</dt><dd>{record.situation}</dd></div><div><dt>Intervention</dt><dd>{record.intervention}</dd></div><div><dt>Consequence</dt><dd>{record.consequence}</dd></div></dl>
        </article>
      ))}
    </div>
    <a class="route-link" href="/impact">Open the impact record <span aria-hidden="true">→</span></a>
  </section>

  <section class="intelligence" aria-labelledby="intelligence-title">
    <div class="intelligence-copy"><p class="section-code">05 / The newest layer</p><h2 id="intelligence-title">AI belongs inside the operating loop, not above it.</h2><p>Useful operational intelligence starts with telemetry and workflow context. It helps narrow a cause, retrieve a runbook, expose a cost signal, or frame a decision. It does not erase uncertainty or ownership.</p><a class="route-link" href="/ai">See the applied AI model <span aria-hidden="true">→</span></a></div>
    <div class="decision-loop" aria-label="Operational AI decision loop">
      <ol><li><span>01</span><strong>Observe</strong><small>Telemetry · incidents · cost</small></li><li><span>02</span><strong>Contextualize</strong><small>History · ownership · runbooks</small></li><li><span>03</span><strong>Assist</strong><small>Patterns · options · uncertainty</small></li><li><span>04</span><strong>Decide</strong><small>Human judgment remains visible</small></li></ol>
      <svg viewBox="0 0 540 220" aria-hidden="true"><path d="M42 110H498"/><circle cx="42" cy="110" r="5"/><circle cx="194" cy="110" r="5"/><circle cx="346" cy="110" r="5"/><circle class="loop-end" cx="498" cy="110" r="8"/></svg>
    </div>
  </section>

  <section class="notes" aria-labelledby="notes-title">
    <header><p class="section-code">06 / Field notes</p><h2 id="notes-title">Written from inside the system.</h2></header>
    <nav aria-label="Selected writing"><a href="/writing/reliability"><span>Reliability</span><strong>Reliability is a product decision.</strong><i aria-hidden="true">→</i></a><a href="/writing/improvement"><span>Improvement</span><strong>Continuous improvement is a way of seeing.</strong><i aria-hidden="true">→</i></a><a href="/writing/bounded-ai"><span>Applied AI</span><strong>AI earns trust one bounded decision at a time.</strong><i aria-hidden="true">→</i></a></nav>
  </section>

  <section class="close" aria-labelledby="close-title"><p class="section-code">Darshan Kansara / Redmond</p><h2 id="close-title">Systems worth understanding.<br />Work worth improving.<br />Ideas worth building.</h2><div><a href="/contact">Start with the real question <span aria-hidden="true">→</span></a><nav aria-label="External profiles"><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></nav></div></section>

  <style>
    :global(body){background:var(--ink)}
    .hero,.system,.records,.operator-builder,.built,.intelligence,.notes,.close{padding-inline:var(--pad)}
    .section-code,.identity,.layer-era,.layer-name small,.record-list header,.record-signal small,.product-status,.product-story dt,.phone-stage>span,.apply-stage>span,.decision-loop span,.decision-loop small,.notes nav span{font-family:var(--font-mono);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase}
    .section-code{color:var(--gold);margin:0}.route-link{display:inline-flex;gap:12px;color:var(--azure-bright);font-size:.84rem;font-weight:500}

    .hero{position:relative;overflow:hidden;border-bottom:1px solid var(--line)}.hero::before{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,transparent 49.9%,var(--line) 50%,transparent 50.1%)}.hero-frame,.proof-line,.system-heading,.layer-ledger,.system>.route-link,.records-heading,.record-list,.records>.route-link,.operator-builder>*,.built-heading,.product-story,.intelligence,.notes>*,.close>*{width:min(var(--max),100%);margin-inline:auto}.hero-frame{min-height:calc(100svh - 204px);display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(50px,7vw,110px);align-items:center;padding-block:clamp(40px,5vw,64px)}.hero-copy{position:relative;z-index:1}.identity{display:flex;flex-wrap:wrap;gap:10px 22px;color:var(--dim);margin-bottom:clamp(28px,4vw,48px)}.identity span:first-child{color:var(--paper)}.hero h1{max-width:14ch;color:var(--paper);font-size:clamp(3.2rem,4.6vw,4.6rem);font-weight:400;line-height:.97;letter-spacing:0}.hero h1 em{color:var(--azure-bright);font-style:normal}.hero-deck{max-width:54ch;margin-top:24px;color:var(--muted);font-size:clamp(1rem,1.3vw,1.12rem);line-height:1.6}.hero-actions{display:flex;flex-wrap:wrap;gap:24px;margin-top:26px}.hero-actions a{color:var(--paper);font-size:.86rem}.hero-actions a:last-child{color:var(--azure-bright)}
    .signal-field{margin:0;min-width:0}.signal-field svg{display:block;width:100%;height:auto}.field-grid{fill:none;stroke:rgba(143,195,247,.08);stroke-width:1}.system-line{fill:none;stroke:#65758a;stroke-width:1.25}.signal-line{fill:none;stroke:var(--azure);stroke-width:2.5;stroke-dasharray:12 16;animation:signal 8s linear infinite}.field-nodes{fill:#9ba9ba}.field-nodes .final-node{fill:var(--gold);filter:drop-shadow(0 0 8px rgba(198,161,90,.55))}.field-labels{fill:#9ba9ba;font:12px var(--font-mono)}.field-labels .final-label{fill:var(--gold)}.field-notes{fill:#66758a;font:10px var(--font-mono);letter-spacing:1px}.signal-field figcaption{text-align:right;color:var(--dim);font-family:var(--font-mono);font-size:.62rem}@keyframes signal{to{stroke-dashoffset:-112}}
    .proof-line{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line)}.proof-line p{min-height:104px;margin:0;padding:24px 26px;display:grid;align-content:center;gap:5px;border-inline-start:1px solid var(--line)}.proof-line p:last-child{border-inline-end:1px solid var(--line)}.proof-line strong{color:var(--paper);font-family:var(--font-display);font-size:1.18rem;font-weight:400}.proof-line span{color:var(--dim);font-size:.72rem}

    .system{padding-block:var(--section);border-bottom:1px solid var(--line)}.system-heading{display:grid;grid-template-columns:var(--rail) 1fr;gap:var(--gutter)}.system-heading>div{display:grid;grid-template-columns:1.08fr .92fr;gap:var(--gutter);align-items:start}.system-heading h2,.records-heading h2,.operator-builder h2,.built-heading h2,.intelligence h2,.notes h2,.close h2{color:var(--paper);font-size:clamp(2.5rem,4.5vw,4.3rem);font-weight:400;line-height:1.02;letter-spacing:0}.system-heading>div>p,.built-heading>div>p,.intelligence-copy>p{color:var(--muted)}
    .layer-ledger{position:relative;margin-top:clamp(62px,8vw,108px)}.layer-spine{position:absolute;left:calc(var(--rail) + var(--gutter) + 4px);top:0;bottom:0;width:1px;background:var(--line)}.layer-spine span{position:absolute;top:0;left:-2px;width:5px;height:100%;background:linear-gradient(var(--azure),var(--gold));transform-origin:top;opacity:.72}.layer-ledger ol{list-style:none;margin:0;padding:0}.layer-ledger li{display:grid;grid-template-columns:var(--rail) minmax(170px,.75fr) 1fr 1fr;gap:var(--gutter);align-items:center;min-height:130px;border-top:1px solid var(--line)}.layer-ledger li:last-child{border-bottom:1px solid var(--line)}.layer-ledger li::before{content:"";position:absolute;left:calc(var(--rail) + var(--gutter) + 1px);width:7px;height:7px;border-radius:50%;background:var(--azure);box-shadow:0 0 0 5px var(--ink)}.layer-ledger li:last-child::before{background:var(--gold)}.layer-era{color:var(--dim)}.layer-name small{color:var(--azure)}.layer-name h3{margin:7px 0 0;color:var(--paper);font-family:var(--font-sans);font-size:1rem;font-weight:500}.layer-ledger li>p{margin:0;color:var(--muted);font-size:.85rem}.layer-ledger blockquote{margin:0;color:var(--paper);font-family:var(--font-display);font-size:1.18rem;line-height:1.35}.system>.route-link,.records>.route-link{margin-top:34px}

    .records{padding-block:var(--section);border-bottom:1px solid var(--line)}.records-heading{display:grid;grid-template-columns:var(--rail) minmax(0,1fr);gap:var(--gutter)}.records-heading h2{max-width:16ch}.record-list{margin-top:70px}.record-list article{display:grid;grid-template-columns:var(--rail) .7fr 1.3fr;gap:var(--gutter);padding:clamp(48px,6vw,76px) 0;border-top:1px solid var(--line)}.record-list article:last-child{border-bottom:1px solid var(--line)}.record-list header{color:var(--dim)}.record-list header span{color:var(--gold)}.record-list header p{margin-top:10px}.record-signal{display:flex;flex-direction:column;justify-content:flex-end;min-height:170px;padding-left:18px;border-left:1px solid var(--accent-rule)}.record-signal strong{color:var(--paper);font-family:var(--font-display);font-size:clamp(2rem,3.4vw,3.25rem);font-weight:400;line-height:1}.record-signal small{margin-top:10px;color:var(--dim)}.record-list dl{margin:0;display:grid;grid-template-columns:repeat(3,1fr)}.record-list dl div{padding:0 18px;border-left:1px solid var(--line)}.record-list dt{color:var(--azure-bright);font-family:var(--font-mono);font-size:.61rem;text-transform:uppercase}.record-list dd{margin:10px 0 0;color:var(--muted);font-size:.84rem;line-height:1.62}

    .operator-builder{padding-block:clamp(76px,10vw,150px);border-bottom:1px solid var(--line);background:rgba(143,195,247,.025)}.contrast-line{display:grid;grid-template-columns:auto 1fr auto;gap:24px;align-items:center;margin-top:46px;color:var(--azure-bright);font-family:var(--font-mono);font-size:.68rem;text-transform:uppercase}.contrast-line p{margin:0}.contrast-line span{height:1px;background:linear-gradient(90deg,var(--azure),var(--gold))}.operator-builder h2{max-width:18ch;margin-top:34px}

    .built{padding-block:var(--section);border-bottom:1px solid var(--line)}.built-heading{display:grid;grid-template-columns:var(--rail) 1fr;gap:var(--gutter);margin-bottom:clamp(60px,8vw,100px)}.built-heading>div{display:grid;grid-template-columns:1.1fr .9fr;gap:var(--gutter)}.product-story{display:grid;grid-template-columns:.88fr 1.12fr;min-height:680px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.product-story+.product-story{margin-top:64px}.product-copy{align-self:center;padding:clamp(38px,6vw,76px) clamp(0px,4vw,58px) clamp(38px,6vw,76px) 0}.product-status{display:flex;align-items:center;gap:9px;color:var(--dim)}.product-status span{width:7px;height:7px;border-radius:50%;background:#62c995;box-shadow:0 0 0 5px rgba(98,201,149,.1)}.product-title{display:flex;align-items:center;gap:18px;margin-top:25px}.product-title img,.product-title i{width:60px;height:60px}.product-title img{border-radius:8px}.product-title i{display:grid;place-items:center;background:var(--paper);color:var(--ink);font:normal .72rem var(--font-mono)}.product-title h3{margin:0;color:var(--paper);font-size:clamp(2.8rem,5vw,4.8rem);font-weight:400}.product-thesis{margin:30px 0;color:var(--azure-bright);font-family:var(--font-display);font-size:clamp(1.25rem,2vw,1.7rem);line-height:1.36}.product-copy dl{margin:0;border-top:1px solid var(--line)}.product-copy dl div{display:grid;grid-template-columns:110px 1fr;gap:20px;padding:14px 0;border-bottom:1px solid var(--line)}.product-story dt{color:var(--gold)}.product-story dd{margin:0;color:var(--muted);font-size:.82rem}.product-copy>a{display:inline-flex;margin-top:30px;color:var(--paper);font-size:.84rem}.phone-stage,.apply-stage{position:relative;overflow:hidden}.phone-stage{min-height:680px;background:linear-gradient(145deg,rgba(77,154,235,.12),rgba(198,161,90,.05));border-left:1px solid var(--line)}.phone-stage .phone{position:absolute;width:min(42%,330px);height:auto;box-shadow:0 30px 80px rgba(0,0,0,.42)}.phone-one{left:15%;top:12%}.phone-two{right:11%;top:23%}.phone-stage>span,.apply-stage>span{position:absolute;right:22px;bottom:18px;color:var(--dim)}.applyready-story{grid-template-columns:1.12fr .88fr}.applyready-story .product-copy{padding-left:clamp(38px,6vw,76px);padding-right:0}.apply-stage{display:grid;place-items:center;padding:clamp(28px,5vw,64px);background:var(--paper)}.apply-stage img{width:100%;height:auto;box-shadow:0 18px 54px rgba(8,17,31,.18)}.apply-stage>span{color:#526174}

    .intelligence{padding-block:var(--section);display:grid;grid-template-columns:.82fr 1.18fr;gap:clamp(50px,8vw,120px);align-items:center;border-bottom:1px solid var(--line)}.intelligence-copy>p:not(.section-code){max-width:56ch}.intelligence-copy .route-link{margin-top:20px}.decision-loop{position:relative;padding:26px;border:1px solid var(--line)}.decision-loop ol{position:relative;z-index:1;list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.decision-loop li{min-height:150px;padding:14px;display:flex;flex-direction:column;background:var(--ink-2);border:1px solid var(--line)}.decision-loop span{color:var(--gold)}.decision-loop strong{margin-top:auto;color:var(--paper);font-size:.86rem;font-weight:500}.decision-loop small{margin-top:7px;color:var(--dim);line-height:1.4;text-transform:none}.decision-loop svg{display:block;width:100%;height:auto;margin-top:-50px}.decision-loop path{stroke:var(--azure);stroke-width:1.5;stroke-dasharray:5 8}.decision-loop circle{fill:var(--azure)}.decision-loop .loop-end{fill:var(--gold)}

    .notes{padding-block:var(--section);border-bottom:1px solid var(--line);display:grid;grid-template-columns:.7fr 1.3fr;gap:var(--gutter)}.notes header{margin:0}.notes nav{border-top:1px solid var(--line)}.notes nav a{display:grid;grid-template-columns:120px 1fr 20px;gap:20px;align-items:center;min-height:86px;border-bottom:1px solid var(--line)}.notes nav span{color:var(--gold)}.notes nav strong{color:var(--paper);font-size:.96rem;font-weight:500}.notes nav i{color:var(--azure);font-style:normal}.close{padding-block:clamp(86px,11vw,164px)}.close h2{max-width:17ch;margin-top:32px}.close>div{display:flex;justify-content:space-between;align-items:center;gap:30px;margin-top:44px}.close>div>a{color:var(--paper)}.close nav{display:flex;gap:22px}.close nav a{color:var(--azure-bright);font-size:.84rem}

