---
import Base from '../layouts/Base.astro';

const uses = [
  ['RCA acceleration', 'Connect incident timelines, telemetry, and recurring patterns to narrow likely cause areas without turning correlation into certainty.'],
  ['Runbook assistance', 'Retrieve attributable operating knowledge inside the workflow and expose the source behind each suggested step.'],
  ['Cost intelligence', 'Detect anomalies and forecast pressure early enough for an engineering response.'],
  ['Decision support', 'Bring relevant context to the point of action while keeping the consequential choice visible.'],
];
---
<Base title="Applied AI" description="Darshan Kansara's operating model for AI: telemetry and workflow context in, bounded assistance out, accountable human decisions retained.">
  <header class="ai-hero"><p class="code">Applied AI / the newest layer</p><div><h1>AI after operations.<br /><em>Not instead of it.</em></h1><p>Twenty-five years around infrastructure, incidents, capacity, reliability, and cost set the order: understand the decision, its evidence, and its consequence before choosing the model.</p></div></header>

  <section class="operating-model" aria-labelledby="model-title"><header><p class="code">01 / Operating model</p><h2 id="model-title">Context in. Bounded assistance out.</h2></header><div class="model-flow"><div class="inputs"><span>Telemetry</span><span>Incident history</span><span>Cost + capacity</span><span>Runbooks</span><span>Ownership</span></div><div class="core"><small>Operational context</small><strong>Evidence + boundaries</strong><p>What happened? What is known? What is uncertain? Who owns the decision?</p></div><div class="outputs"><span>Cause areas</span><span>Relevant procedure</span><span>Cost signal</span><span>Decision options</span></div></div></section>

  <section class="use-cases" aria-labelledby="uses-title"><header><p class="code">02 / Useful territory</p><h2 id="uses-title">Better signal should change the work.</h2></header><ol>{uses.map(([title,body],index)=><li><span>0{index+1}</span><h3>{title}</h3><p>{body}</p></li>)}</ol></section>

  <section class="guardrails" aria-labelledby="guardrails-title"><header><p class="code">03 / Non-negotiables</p><h2 id="guardrails-title">The system must show its work.</h2></header><dl><div><dt>Evidence</dt><dd>Make telemetry visible, searchable, and attributable.</dd></div><div><dt>Boundary</dt><dd>Say what the system cannot know.</dd></div><div><dt>Control</dt><dd>Keep consequential action with the person.</dd></div><div><dt>Feedback</dt><dd>Make correction part of the operating loop.</dd></div></dl></section>

  <section class="product-proof"><p class="code">Applied under product constraints</p><div><h2>LifeLens protects uncertainty.<br />ApplyReady separates evidence from gaps.</h2><p>The principles become credible when they survive a real interface, real user data, and a real decision.</p></div><nav><a href="/lifelens">LifeLens <span>On-device photo intelligence →</span></a><a href="/applyready">ApplyReady <span>Evidence-led role analysis →</span></a></nav></section>

  <style>
    :global(body),:global(main){background:var(--ink);color:var(--text)}.code,.model-flow small,.model-flow span,.use-cases li>span,.guardrails dt{font-family:var(--font-mono);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase}.code{color:var(--gold)}.ai-hero,.operating-model,.use-cases,.guardrails,.product-proof{padding-inline:max(var(--pad),calc((100vw - var(--max))/2))}.ai-hero{min-height:calc(70svh - 100px);padding-block:var(--section);display:grid;grid-template-columns:var(--rail) 1fr;gap:var(--gutter);align-items:end;border-bottom:1px solid var(--line)}.ai-hero h1{max-width:15ch;color:var(--paper);font-size:clamp(3.2rem,5vw,5rem);font-weight:400;line-height:.98}.ai-hero h1 em{color:var(--azure-bright);font-style:normal}.ai-hero div>p{max-width:62ch;color:var(--muted);font-size:1.08rem}.operating-model,.use-cases,.guardrails,.product-proof{padding-block:var(--section);border-bottom:1px solid var(--line)}.operating-model>header,.use-cases>header,.guardrails>header{display:grid;grid-template-columns:var(--rail) 1fr;gap:var(--gutter)}.operating-model h2,.use-cases h2,.guardrails h2,.product-proof h2{max-width:16ch;color:var(--paper);font-size:clamp(2.45rem,4.3vw,4.1rem);font-weight:400}.model-flow{margin-top:64px;display:grid;grid-template-columns:.8fr 1.25fr .8fr;gap:34px;align-items:center}.inputs,.outputs{display:grid;gap:8px}.model-flow span{padding:12px;border:1px solid var(--line);color:var(--dim);text-align:center}.core{position:relative;padding:38px;border:1px solid var(--accent-rule);background:var(--accent-soft)}.core::before,.core::after{content:"";position:absolute;top:50%;width:34px;height:1px;background:var(--gold)}.core::before{right:100%}.core::after{left:100%}.core small{color:var(--gold)}.core strong{display:block;margin-top:12px;color:var(--paper);font-family:var(--font-display);font-size:1.8rem;font-weight:400}.core p{margin:12px 0 0;color:var(--muted);font-size:.85rem}.use-cases ol{list-style:none;margin:60px 0 0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.use-cases li{min-height:260px;padding:24px;display:flex;flex-direction:column;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.use-cases li>span{color:var(--gold)}.use-cases h3{margin-top:auto;color:var(--paper);font-family:var(--font-sans);font-size:1rem;font-weight:500}.use-cases li p{color:var(--muted);font-size:.84rem}.guardrails dl{margin:60px 0 0;border-top:1px solid var(--line)}.guardrails dl div{display:grid;grid-template-columns:var(--rail) 1fr;gap:var(--gutter);padding:24px 0;border-bottom:1px solid var(--line)}.guardrails dt{color:var(--azure-bright)}.guardrails dd{margin:0;color:var(--paper);font-family:var(--font-display);font-size:clamp(1.2rem,2vw,1.6rem)}.product-proof{display:grid;grid-template-columns:var(--rail) 1fr .8fr;gap:var(--gutter);align-items:start}.product-proof>div>p{max-width:52ch;color:var(--muted)}.product-proof nav{border-top:1px solid var(--line)}.product-proof nav a{display:grid;gap:4px;padding:20px 0;border-bottom:1px solid var(--line);color:var(--paper)}.product-proof nav span{color:var(--azure-bright);font-size:.78rem}
    @media(max-width:800px){.ai-hero,.operating-model>header,.use-cases>header,.guardrails>header,.product-proof{grid-template-columns:1fr}.model-flow{grid-template-columns:1fr}.core::before,.core::after{display:none}.use-cases ol{grid-template-columns:1fr 1fr}.product-proof nav{margin-top:24px}}@media(max-width:520px){.ai-hero{min-height:auto}.ai-hero h1{font-size:clamp(2.8rem,12vw,3.6rem)}.use-cases ol{grid-template-columns:1fr}.use-cases li{min-height:180px}.guardrails dl div{grid-template-columns:1fr;gap:8px}}
  </style>
</Base>
