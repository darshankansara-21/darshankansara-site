---
import Base from '../layouts/Base.astro';
const appUrl = 'https://applyready.darshankansara.com';
---
<Base title="ApplyReady" description="ApplyReady is a private, evidence-backed workspace for deciding whether to apply, understanding real resume gaps, and building truthful application documents." image="/applyready/fit.png">
  <header class="ar-hero">
    <div class="brand"><span aria-hidden="true">AR</span><strong>ApplyReady</strong><small>Live web product</small></div>
    <div class="hero-copy"><p class="code">Application intelligence without invented experience</p><h1>Fit before polish.<br /><em>Evidence before advice.</em></h1><p>Compare a resume with a role, inspect the supported experience and the real gaps, then build an application pack the applicant can defend.</p><nav><a href={appUrl} target="_blank" rel="noopener noreferrer">Open ApplyReady ↗</a><a href="#workflow">See the workflow ↓</a></nav><small>No account · Resume text is not stored · Review every generated document</small></div>
    <figure><span>Decision / evidence</span><img src="/applyready/fit.png" alt="ApplyReady example showing an evidence-backed resume and role fit decision" width="1200" height="1200" /></figure>
  </header>
  <section class="contract"><p>Decide before rewriting</p><p>Show evidence and gaps</p><p>Never invent experience</p></section>
  <section id="workflow" class="workflow"><header><p class="code">01 / Decision workflow</p><h2>One application, considered properly.</h2><p>ApplyReady is organized around the decision a person is actually making, not a score designed to keep them clicking.</p></header><ol><li><span>01</span><div><strong>Bring the role and resume.</strong><p>Paste a job description or use a supported job URL, then add the resume intended for the role.</p></div><small>Input</small></li><li><span>02</span><div><strong>Read evidence before advice.</strong><p>See matched experience, missing requirements, resume hygiene issues, and an Apply, Apply with caution, or Skip direction.</p></div><small>Decision</small></li><li><span>03</span><div><strong>Build only from what is true.</strong><p>Prepare tailored positioning, cover-letter material, interview questions, and editable Word documents without adding unsupported skills or credentials.</p></div><small>Output</small></li></ol></section>
  <section class="boundary"><header><p class="code">02 / The important boundary</p><h2>A stronger application should not require a more fictional applicant.</h2><p>Many tools begin with rewriting. ApplyReady begins with fit. It separates evidence already present from requirements that remain unproven.</p><blockquote>Clarity first. Documents second. The applicant owns the final claim.</blockquote></header><div class="evidence-flow"><div><span>Resume</span><small>What you can support</small></div><i></i><div class="focus"><span>Evidence check</span><small>Matches, gaps, and caution</small></div><i></i><div><span>Your decision</span><small>Apply, pause, or skip</small></div></div></section>
  <section class="privacy"><header><p class="code">03 / Private by default</p><h2>Work in progress should be treated that way.</h2></header><dl><div><dt>No account or email gate</dt><dd>Open the workspace without creating a profile.</dd></div><div><dt>Browser-side analysis</dt><dd>Resume-to-role matching is deterministic and runs in the browser.</dd></div><div><dt>Resume text is not stored</dt><dd>The service does not retain the application content.</dd></div></dl></section>
  <section class="ar-close"><p class="code">Use it on a real role</p><h2>Know what the application can honestly say.</h2><p>Application assistance, not a guarantee of ATS acceptance, interviews, or employment.</p><a href={appUrl} target="_blank" rel="noopener noreferrer">Open ApplyReady ↗</a></section>
  <style>
    :global(body),:global(main){background:var(--ink);color:var(--text)}.code,.brand small,.hero-copy>small,.ar-hero figure>span,.workflow li>span,.workflow li>small,.privacy dt{font-family:var(--font-mono);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase}.code{color:var(--gold)}.ar-hero,.contract,.workflow,.boundary,.privacy,.ar-close{padding-inline:max(var(--pad),calc((100vw - var(--max))/2))}
    .ar-hero{min-height:720px;display:grid;grid-template-columns:var(--rail) 1.05fr .85fr;gap:var(--gutter);align-items:center;border-bottom:1px solid var(--line)}.brand{align-self:start;margin-top:76px;display:grid;grid-template-columns:52px 1fr;gap:3px 13px;align-items:center}.brand>span{grid-row:1/3;width:52px;height:52px;display:grid;place-items:center;background:var(--paper);color:var(--ink);font:.7rem var(--font-mono)}.brand strong{color:var(--paper);font-weight:500}.brand small{color:var(--dim)}.hero-copy{padding-block:84px}.hero-copy h1{max-width:12ch;color:var(--paper);font-size:clamp(3.2rem,5.4vw,5.5rem);font-weight:400;line-height:.94}.hero-copy h1 em{color:var(--azure-bright);font-style:normal}.hero-copy>p:not(.code){max-width:55ch;color:var(--muted);font-size:1.05rem}.hero-copy nav{display:flex;gap:12px;margin:30px 0 14px}.hero-copy nav a{padding:11px 16px;border:1px solid var(--line);color:var(--paper);font-size:.84rem}.hero-copy nav a:first-child{background:var(--paper);color:var(--ink)}.hero-copy>small{color:var(--dim)}.ar-hero figure{position:relative;margin:0;padding:32px;border:1px solid var(--line);background:rgba(77,154,235,.08)}.ar-hero figure>span{position:absolute;right:0;top:-27px;color:var(--dim)}.ar-hero figure img{display:block;width:100%;box-shadow:0 24px 64px rgba(0,0,0,.3)}
    .contract{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid var(--line)}.contract p{min-height:86px;margin:0;padding:26px 20px;border-left:1px solid var(--line);color:var(--paper);font-size:.82rem}.contract p:last-child{border-right:1px solid var(--line)}.workflow,.boundary,.privacy,.ar-close{padding-block:var(--section);border-bottom:1px solid var(--line)}.workflow header,.privacy header{display:grid;grid-template-columns:var(--rail) 1fr 1fr;gap:var(--gutter);align-items:start}.workflow h2,.boundary h2,.privacy h2,.ar-close h2{color:var(--paper);font-size:clamp(2.45rem,4.2vw,4rem);font-weight:400}.workflow header>p:last-child{color:var(--muted)}.workflow ol{list-style:none;margin:58px 0 0;padding:0;border-top:1px solid var(--line)}.workflow li{display:grid;grid-template-columns:64px 1fr 90px;gap:28px;padding:28px 0;border-bottom:1px solid var(--line)}.workflow li>span{color:var(--gold)}.workflow li>small{text-align:right;color:var(--dim)}.workflow li strong{color:var(--paper);font-family:var(--font-display);font-size:1.3rem;font-weight:400}.workflow li p{margin:6px 0 0;max-width:66ch;color:var(--muted)}.boundary{display:grid;grid-template-columns:1fr 1fr;gap:clamp(54px,9vw,130px);align-items:center}.boundary header>p:not(.code){max-width:59ch;color:var(--muted)}blockquote{margin:32px 0 0;padding-left:20px;border-left:2px solid var(--gold);color:var(--azure-bright);font-family:var(--font-display);font-size:1.3rem}.evidence-flow{padding:28px;border:1px solid var(--line)}.evidence-flow div{display:grid;gap:3px;padding:20px;border:1px solid var(--line)}.evidence-flow span{color:var(--paper);font-weight:500}.evidence-flow small{color:var(--dim)}.evidence-flow .focus{background:var(--accent-soft);border-color:var(--accent-rule)}.evidence-flow i{display:block;width:1px;height:24px;margin-left:28px;background:var(--line)}.privacy dl{margin:58px 0 0;border-top:1px solid var(--line)}.privacy dl div{display:grid;grid-template-columns:var(--rail) 1fr;gap:var(--gutter);padding:21px 0;border-bottom:1px solid var(--line)}.privacy dt{color:var(--gold)}.privacy dd{margin:0;color:var(--paper);font-family:var(--font-display);font-size:1.3rem}.ar-close h2{max-width:17ch}.ar-close>p:not(.code){color:var(--muted)}.ar-close a{display:inline-flex;margin-top:18px;color:var(--azure-bright)}
    @media(max-width:900px){.ar-hero{grid-template-columns:130px 1fr}.ar-hero figure{grid-column:2;margin-bottom:70px}.workflow header,.privacy header{grid-template-columns:1fr}.boundary{grid-template-columns:1fr}}@media(max-width:620px){.ar-hero{grid-template-columns:1fr}.brand{margin-top:48px}.hero-copy{padding-block:30px}.hero-copy h1{font-size:clamp(2.8rem,12vw,3.7rem)}.hero-copy nav{flex-direction:column}.ar-hero figure{grid-column:auto;margin-bottom:70px}.contract{grid-template-columns:1fr}.workflow li{grid-template-columns:34px 1fr}.workflow li>small{display:none}.privacy dl div{grid-template-columns:1fr;gap:8px}}
  </style>
</Base>
