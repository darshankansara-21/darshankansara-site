---
import Base from '../layouts/Base.astro';

const appUrl = 'https://applyready.darshankansara.com';
---
<Base title="ApplyReady" description="ApplyReady is a private, evidence-backed workspace for deciding whether to apply, understanding real resume gaps, and building truthful application documents." image="/applyready/fit.png">
    <section class="ar-hero">
      <div class="ar-copy">
        <div class="ar-brand"><span class="mark" aria-hidden="true">AR</span><strong>ApplyReady</strong><span>Live web product</span></div>
        <p class="kicker">Application intelligence without invented experience</p>
        <h1>Should you apply?<br /><em>Know before you rewrite.</em></h1>
        <p class="intro">Compare your resume with a role, see the evidence and the real gaps, then build an application pack you can defend.</p>
        <div class="actions"><a href={appUrl} target="_blank" rel="noopener noreferrer">Open ApplyReady <span aria-hidden="true">&nearr;</span></a><a href="#workflow">See how it works <span aria-hidden="true">&darr;</span></a></div>
        <p class="availability">No account · Resume text is not stored · Review every generated document</p>
      </div>
      <div class="ar-visual"><img src="/applyready/fit.png" alt="ApplyReady example showing an evidence-backed resume and role fit decision" width="1200" height="1200" decoding="async" /></div>
    </section>

    <section class="decision-strip" aria-label="ApplyReady principles">
      <div><span>01</span><strong>Decide before rewriting</strong></div><div><span>02</span><strong>Show evidence and gaps</strong></div><div><span>03</span><strong>Never invent experience</strong></div>
    </section>

    <section id="workflow" class="workflow">
      <header><p class="kicker">The workflow</p><h2>One application, considered properly.</h2><p>ApplyReady is organized around the decision a person is actually trying to make, not a score designed to keep them clicking.</p></header>
      <ol>
        <li><span>01</span><div><strong>Bring the role and the resume.</strong><p>Paste a job description or use a supported job URL, then add the resume you intend to use.</p></div><small>Input</small></li>
        <li><span>02</span><div><strong>Read the evidence before the advice.</strong><p>See matched experience, missing requirements, resume hygiene issues, and an Apply, Apply with caution, or Skip direction.</p></div><small>Decision</small></li>
        <li><span>03</span><div><strong>Build from what is true.</strong><p>Prepare tailored positioning, cover-letter material, interview questions, and editable Word documents without adding skills or credentials that are not present.</p></div><small>Output</small></li>
      </ol>
    </section>

    <section class="boundary">
      <div class="boundary-copy"><p class="kicker">The important boundary</p><h2>A stronger application should not require a more fictional applicant.</h2><p>Many tools begin with rewriting. ApplyReady begins with fit. It separates evidence already in the resume from requirements that remain unproven, so the applicant can make an informed choice before polishing the language.</p><blockquote>Clarity first. Documents second. The applicant owns the final claim.</blockquote></div>
      <div class="evidence-flow" aria-label="ApplyReady evidence flow"><div><span>Resume</span><small>What you can support</small></div><i aria-hidden="true"></i><div class="focus"><span>Evidence check</span><small>Matches, gaps, and caution</small></div><i aria-hidden="true"></i><div><span>Your decision</span><small>Apply, pause, or skip</small></div></div>
    </section>

    <section class="privacy">
      <header><p class="kicker">Private by default</p><h2>Your application is work in progress. It should be treated that way.</h2></header>
      <div class="privacy-facts"><p><strong>No account or email gate.</strong><span>Open the workspace and use it without creating a profile.</span></p><p><strong>Analysis runs in the browser.</strong><span>Resume-to-role matching is deterministic and browser-side.</span></p><p><strong>Resume content is not stored.</strong><span>The service does not retain the application text.</span></p></div>
    </section>

    <section class="ar-close"><div><p class="kicker">Use it on a real role</p><h2>Know what the application can honestly say.</h2><p>ApplyReady provides application assistance, not a guarantee of ATS acceptance, interviews, or employment.</p><a href={appUrl} target="_blank" rel="noopener noreferrer">Open ApplyReady <span aria-hidden="true">&nearr;</span></a></div></section>
  <style>
    main{background:#f3f1ea}.kicker{font-family:var(--font-mono);font-size:.68rem;letter-spacing:.15em;text-transform:uppercase;color:#a06f24}.ar-hero{min-height:720px;background:#f7f5ee;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:clamp(48px,7vw,100px);padding:clamp(68px,8vw,100px) max(var(--pad),calc((100vw - var(--max))/2))}.ar-copy{max-width:700px}.ar-brand{display:flex;align-items:center;gap:13px;margin-bottom:62px}.ar-brand .mark{display:grid;place-items:center;width:46px;height:46px;background:#17365f;color:#fff;font-family:var(--font-mono);font-size:.68rem}.ar-brand strong{font-family:var(--font-display);font-size:1.2rem}.ar-brand>span:last-child{margin-left:auto;font-family:var(--font-mono);font-size:.6rem;text-transform:uppercase;color:#637187}.ar-hero h1{font-size:clamp(3rem,5.4vw,5.25rem);line-height:.97;letter-spacing:-.04em;margin:24px 0 28px;max-width:11ch}.ar-hero h1 em{color:#387cc5;font-style:normal}.intro{font-family:var(--font-display);font-size:clamp(1.08rem,1.8vw,1.35rem);line-height:1.55;color:#44546a;max-width:33em}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:32px}.actions a,.ar-close a{display:inline-flex;justify-content:center;padding:12px 18px;border:1px solid #17365f;font-weight:700;color:#17365f}.actions a:first-child,.ar-close a{background:#17365f;color:#fff}.availability{margin:16px 0 0;font-family:var(--font-mono);font-size:.62rem;color:#788497}.ar-visual{background:#dce5ef;padding:clamp(22px,4vw,48px)}.ar-visual img{display:block;width:100%;height:auto;box-shadow:0 24px 70px rgba(17,40,72,.16)}
    .decision-strip{width:min(var(--max),calc(100% - 2 * var(--pad)));margin:auto;display:grid;grid-template-columns:repeat(3,1fr);border-left:1px solid var(--line)}.decision-strip div{min-height:90px;display:flex;align-items:center;gap:14px;padding:20px 24px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.decision-strip span{font-family:var(--font-mono);font-size:.62rem;color:#3f86d5}.decision-strip strong{font-size:.86rem}
    .workflow{width:min(var(--max),calc(100% - 2 * var(--pad)));margin:auto;padding:clamp(82px,9vw,118px) 0}.workflow header{display:grid;grid-template-columns:190px 1fr 1fr;gap:clamp(30px,6vw,80px);align-items:start;margin-bottom:54px}.workflow header h2,.boundary h2,.privacy h2,.ar-close h2{font-size:clamp(2.25rem,4vw,3.6rem);line-height:1.05;letter-spacing:-.035em;margin:0}.workflow header>p:last-child{color:var(--muted)}.workflow ol{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}.workflow li{display:grid;grid-template-columns:60px 1fr 90px;gap:30px;padding:28px 0;border-bottom:1px solid var(--line)}.workflow li>span,.workflow li>small{font-family:var(--font-mono);font-size:.62rem;text-transform:uppercase;color:#3f86d5}.workflow li>small{text-align:right;color:var(--muted)}.workflow li strong{font-family:var(--font-display);font-size:1.22rem}.workflow li p{margin:7px 0 0;color:var(--muted);max-width:66ch}
    .boundary{background:#10243f;color:#bec9d8;padding:clamp(82px,9vw,118px) max(var(--pad),calc((100vw - var(--max))/2));display:grid;grid-template-columns:1fr 1fr;gap:clamp(54px,9vw,130px);align-items:center}.boundary h2{color:#fff;margin:22px 0 28px}.boundary-copy>p{max-width:60ch}.boundary blockquote{margin:34px 0 0;padding-left:22px;border-left:2px solid #d0a34d;color:#fff;font-family:var(--font-display);font-size:1.25rem}.evidence-flow{padding:30px;border:1px solid rgba(255,255,255,.16)}.evidence-flow div{padding:20px;border:1px solid rgba(255,255,255,.14);display:grid;gap:4px}.evidence-flow span{color:#fff;font-weight:700}.evidence-flow small{color:#8293aa}.evidence-flow .focus{background:rgba(64,141,228,.11);border-color:rgba(112,183,255,.45)}.evidence-flow i{display:block;width:1px;height:25px;background:rgba(255,255,255,.25);margin-left:30px}
    .privacy{width:min(var(--max),calc(100% - 2 * var(--pad)));margin:auto;padding:clamp(82px,9vw,118px) 0;display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(54px,9vw,130px)}.privacy header .kicker{margin-bottom:20px}.privacy-facts{border-top:1px solid var(--line)}.privacy-facts p{display:grid;grid-template-columns:.8fr 1.2fr;gap:24px;padding:20px 0;margin:0;border-bottom:1px solid var(--line)}.privacy-facts span{color:var(--muted);font-size:.9rem}.ar-close{background:#dce5ef;padding:clamp(78px,9vw,110px) var(--pad)}.ar-close>div{width:min(var(--max),100%);margin:auto}.ar-close h2{max-width:16ch;margin:20px 0 24px}.ar-close p:not(.kicker){color:var(--muted);max-width:58ch}.ar-close a{margin-top:18px}@media(max-width:850px){.ar-hero{grid-template-columns:1fr}.ar-copy{padding-top:20px}.ar-visual{max-width:620px}.workflow header{grid-template-columns:1fr}.boundary,.privacy{grid-template-columns:1fr}.decision-strip{grid-template-columns:1fr}}@media(max-width:600px){.ar-hero{padding-top:50px}.ar-brand{flex-wrap:wrap;margin-bottom:32px}.ar-brand>span:last-child{width:100%;margin-left:59px}.ar-hero h1{font-size:clamp(2.7rem,12vw,3.6rem);margin-top:20px}.intro{font-size:1rem}.actions{flex-direction:column}.workflow li{grid-template-columns:32px 1fr}.workflow li>small{display:none}.privacy-facts p{grid-template-columns:1fr;gap:5px}}
  </style>
  <style>
    :global(body),main{background:var(--ink);color:var(--text)}.kicker{color:var(--gold);letter-spacing:.09em}
    .ar-hero,.boundary,.ar-close{background:transparent;color:var(--text);border-bottom:1px solid var(--line)}.ar-hero{min-height:720px}.ar-brand .mark{background:var(--paper);color:var(--ink)}.ar-brand strong{color:var(--paper);font-family:var(--font-sans);font-weight:500}.ar-brand>span:last-child{color:var(--dim)}
    .ar-hero h1{color:var(--paper);font-size:clamp(3.4rem,6.4vw,6.4rem);line-height:.88;letter-spacing:0;font-weight:400}.ar-hero h1 em{color:var(--azure-bright)}.intro{font-family:var(--font-sans);color:var(--muted)}
    .actions a,.ar-close a{border-color:var(--line);color:var(--paper);font-weight:500}.actions a:first-child,.ar-close a{background:var(--paper);color:var(--ink)}.availability{color:var(--dim)}.ar-visual{background:rgba(126,184,201,.1);border:1px solid var(--line);padding:clamp(18px,3vw,38px)}.ar-visual img{box-shadow:0 24px 70px rgba(0,0,0,.3)}
    .decision-strip,.decision-strip div{border-color:var(--line)}.decision-strip span{color:var(--gold)}.decision-strip strong{color:var(--paper)}
    .workflow header h2,.boundary h2,.privacy h2,.ar-close h2{color:var(--paper);font-weight:400;letter-spacing:0}.workflow header>p:last-child,.workflow li p,.privacy-facts span,.ar-close p:not(.kicker){color:var(--muted)}.workflow ol,.workflow li,.privacy-facts,.privacy-facts p{border-color:var(--line)}.workflow li>span{color:var(--gold)}.workflow li strong,.privacy-facts strong{color:var(--paper);font-weight:500}
    .boundary{border-block:1px solid var(--line)}.boundary blockquote{color:var(--azure-bright);border-color:var(--gold);font-weight:400}.evidence-flow,.evidence-flow div{border-color:var(--line)}.evidence-flow span{color:var(--paper)}.evidence-flow small{color:var(--dim)}.evidence-flow .focus{background:var(--accent-soft);border-color:var(--accent-rule)}.evidence-flow i{background:var(--line)}
    .ar-close{border-top:1px solid var(--line)}
  </style>
</Base>
