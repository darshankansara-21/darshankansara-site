---
import Base from '../layouts/Base.astro';

const evidence = [
  ['01', 'Cloud economics', '$1M+', 'annual Azure platform savings', 'Recurring infrastructure spend was growing without enough engineering visibility.', 'Right-size capacity, improve reservation strategy, automate visibility, and remove idle infrastructure.', 'Cost gained technical owners and earlier signals instead of arriving as a late finance surprise.'],
  ['02', 'Reliability', 'Test before scale', 'uncertainty moved left', 'Infrastructure changes carried uncertainty too close to live Azure datacenters.', 'Establish the first Azure Datacenter Instrumentation and Pre-Production Lab.', 'Teams could learn before broad rollout carried uncertainty into production.'],
  ['03', 'Platform operations', 'Readiness by design', 'before release, not after', 'Monitoring, incident response, continuity, and runbooks entered too late.', 'Connect readiness reviews and ownership to the same platform signals used by engineering.', 'Critical data-platform change became more predictable and accountable.'],
  ['04', 'Continuous improvement', 'One operating view', 'capacity · finance · supply', 'Operational pressure appeared differently across capacity, finance, and supply-chain teams.', 'Use automation, measurement, Lean, and Kaizen against recurring delay.', 'Cost and operational risk became visible early enough for teams to act.'],
];
---
<Base title="Evidence" description="Documented operating outcomes from Darshan Kansara's work across Azure economics, datacenter reliability, platform operations, and continuous improvement.">
  <header class="impact-hero"><p class="code">Evidence / selected operating records</p><div><h1>What changed is the proof.</h1><p>Titles describe responsibility. These records describe intervention: the condition, the operating change, and the consequence that followed.</p></div></header>
  <section class="evidence" aria-label="Selected impact evidence">
    {evidence.map(([id,label,signal,suffix,situation,intervention,consequence]) => <article><header><span>{id}</span><p>{label}</p></header><div class="outcome"><strong>{signal}</strong><small>{suffix}</small></div><div class="record"><dl><div><dt>Condition</dt><dd>{situation}</dd></div><div><dt>Operating change</dt><dd>{intervention}</dd></div><div><dt>Why it mattered</dt><dd>{consequence}</dd></div></dl></div></article>)}
  </section>
  <section class="impact-close"><p class="code">Method behind the record</p><h2>Understand the system. Expose the signal. Move the decision earlier.</h2><a href="/experience">Trace where that method came from →</a></section>
  <style>
    :global(body),:global(main){background:var(--ink);color:var(--text)}.code,.evidence header,.outcome small,dt{font-family:var(--font-mono);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase}.code{color:var(--gold)}.impact-hero,.evidence,.impact-close>*{width:min(var(--max),calc(100% - 2 * var(--pad)));margin-inline:auto}.impact-hero{min-height:calc(68svh - 100px);padding-block:var(--section);display:grid;grid-template-columns:var(--rail) 1fr;gap:var(--gutter);align-items:end;border-bottom:1px solid var(--line)}.impact-hero h1{max-width:13ch;color:var(--paper);font-size:clamp(3.2rem,5vw,5rem);font-weight:400;line-height:.98}.impact-hero div>p{max-width:58ch;color:var(--muted);font-size:1.08rem}.evidence article{display:grid;grid-template-columns:var(--rail) minmax(220px,.68fr) 1.32fr;gap:var(--gutter);padding:clamp(58px,7vw,94px) 0;border-bottom:1px solid var(--line)}.evidence header{color:var(--dim)}.evidence header span{color:var(--gold)}.evidence header p{margin-top:9px}.outcome{min-height:190px;display:flex;flex-direction:column;justify-content:flex-end;padding-left:18px;border-left:1px solid var(--accent-rule)}.outcome strong{color:var(--paper);font-family:var(--font-display);font-size:clamp(2rem,3.5vw,3.35rem);font-weight:400;line-height:1}.outcome small{margin-top:10px;color:var(--dim)}.record dl{margin:0;display:grid;grid-template-columns:repeat(3,1fr);height:100%}.record dl div{padding:0 18px;border-left:1px solid var(--line)}dt{color:var(--azure-bright)}dd{margin:10px 0 0;color:var(--muted);font-size:.85rem;line-height:1.62}.impact-close{padding-block:var(--section);border-top:1px solid var(--line)}.impact-close h2{max-width:18ch;color:var(--paper);font-size:clamp(2.5rem,4.5vw,4.3rem);font-weight:400}.impact-close a{display:inline-flex;margin-top:22px;color:var(--azure-bright)}
    @media(max-width:850px){.impact-hero{grid-template-columns:1fr;gap:20px}.evidence article{grid-template-columns:110px .75fr 1.25fr}.record dl{grid-template-columns:1fr}.record dl div{padding:10px 0;border-left:0;border-top:1px solid var(--line)}}@media(max-width:620px){.impact-hero{min-height:auto}.impact-hero h1{font-size:clamp(2.8rem,12vw,3.6rem)}.evidence article{grid-template-columns:1fr;gap:22px}.evidence header{display:flex;gap:14px}.outcome{min-height:0}.record dl{grid-template-columns:1fr}}
  </style>
</Base>
