---
import { site } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} - ${site.name}` : `${site.name} - ${site.role}`;
const pageDesc = description ?? site.subheadline;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta name="theme-color" content="#07080c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+Devanagari:wght@500;600&display=swap" />
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('theme');
          document.documentElement.dataset.theme = (saved === 'navy' || saved === 'dark') ? saved : 'dark';
        } catch (e) { document.documentElement.dataset.theme = 'dark'; }
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="invocation" aria-label="Shree Krushna Sadaa Sahaayate">
      <span class="sk">|| श्री कृष्ण सदा सहायते ||</span>
      <span class="sk-en">Shree Krushna Sadaa Sahaayate</span>
    </div>

    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label="Home">
          <span class="brand-mark">{site.initials}</span>
          <span class="brand-text">
            <span class="brand-name">{site.name}</span>
            <span class="brand-role">{site.role}</span>
          </span>
        </a>
        <nav class="primary-nav" aria-label="Primary">
          <a href="/#impact">Impact</a>
          <a href="/#journey">Journey</a>
          <a href="/#ai">AI &amp; Operations</a>
          <a href="/#writing">Writing</a>
          <a href="/experience">Experience</a>
          <a href="/#contact" class="nav-contact">Contact <span aria-hidden="true">&rarr;</span></a>
        </nav>
        <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
      <nav class="mobile-nav" id="mobileNav" aria-label="Mobile">
        <a href="/#impact">Impact</a>
        <a href="/#journey">Journey</a>
        <a href="/#ai">AI &amp; Operations</a>
        <a href="/#writing">Writing</a>
        <a href="/experience">Experience</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <div class="ft-name">{site.name}</div>
          <div class="ft-meta">{site.role} - {site.org} - {site.location}</div>
        </div>
        <div class="ft-links">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          {site.linkedin && <a href={site.linkedin}>LinkedIn</a>}
          {site.github && <a href={site.github}>GitHub</a>}
        </div>
        <div class="ft-copy">&copy; {new Date().getFullYear()} {site.name}</div>
      </div>
      <div class="footer-mark" aria-hidden="true">
        <img src="/mustang.png" alt="" loading="lazy" decoding="async" />
      </div>
    </footer>

    <button id="themeToggle" class="theme-toggle" type="button"
            aria-label="Switch color theme" title="Switch theme">
      <span class="tt-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path class="tt-moon" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          <g class="tt-sun">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </g>
        </svg>
      </span>
      <span class="tt-label"></span>
    </button>

    <script is:inline>
      // Theme toggle (dark <-> navy)
      const tt = document.getElementById('themeToggle');
      const ttLabel = tt && tt.querySelector('.tt-label');
      const setLabel = () => {
        const t = document.documentElement.dataset.theme;
        if (ttLabel) ttLabel.textContent = t === 'navy' ? 'Dark' : 'Navy';
        if (tt) tt.setAttribute('aria-label', t === 'navy' ? 'Switch to dark theme' : 'Switch to navy theme');
      };
      setLabel();
      if (tt) tt.addEventListener('click', () => {
        const cur = document.documentElement.dataset.theme;
        const next = cur === 'navy' ? 'dark' : 'navy';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
        setLabel();
      });

      // Mobile nav toggle
      const tgl = document.getElementById('navToggle');
      const mn  = document.getElementById('mobileNav');
      if (tgl && mn) tgl.addEventListener('click', () => {
        const open = mn.classList.toggle('open');
        tgl.setAttribute('aria-expanded', String(open));
      });
      // Close mobile nav after click
      if (mn) mn.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
        mn.classList.remove('open');
        if (tgl) tgl.setAttribute('aria-expanded', 'false');
      }));

      // Subtle reveal on scroll
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
      }
    </script>

    <style is:global>
      :root {
        --max: 1120px;
        --max-wide: 1280px;
        --pad: 28px;
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-display: 'Inter Tight', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      }
      :root, html[data-theme="dark"] {
        --bg: #06070b;             /* near-black with a navy undertone */
        --bg-elev: #0b0d14;        /* graphite */
        --bg-deep: #04050a;        /* used for signature moment */
        --surface: rgba(255,255,255,0.02);
        --text: #e6e8ef;
        --text-strong: #ffffff;
        --platinum: #c9d0dc;       /* warm platinum */
        --muted: #8a8d99;
        --dim: #5b5e6c;
        --rule: rgba(255,255,255,0.07);
        --rule-strong: rgba(255,255,255,0.14);
        --accent: #c7a96b;         /* warm refined gold */
        --accent-soft: rgba(199,169,107,0.14);
        --accent-rule: rgba(199,169,107,0.30);
        --azure: #5aa9ff;          /* muted Azure blue */
        --azure-soft: rgba(90,169,255,0.12);
        --link: #e6e8ef;
        --header-bg: rgba(6,7,11,0.72);
      }
      html[data-theme="navy"] {
        --bg: #0a1733;
        --bg-elev: #122a55;
        --bg-deep: #060f25;
        --surface: rgba(255,255,255,0.04);
        --text: #e6ecf8;
        --text-strong: #ffffff;
        --platinum: #c8d4ec;
        --muted: #93a4c6;
        --dim: #6c80a8;
        --rule: rgba(255,255,255,0.10);
        --rule-strong: rgba(255,255,255,0.20);
        --accent: #d4b774;
        --accent-soft: rgba(212,183,116,0.16);
        --accent-rule: rgba(212,183,116,0.36);
        --azure: #6ea8ff;
        --azure-soft: rgba(110,168,255,0.18);
        --link: #ffffff;
        --header-bg: rgba(10,23,51,0.78);
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-sans);
        font-size: 16px; line-height: 1.6;
        font-feature-settings: 'ss01', 'cv11', 'kern';
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        min-height: 100vh;
      }
      ::selection { background: var(--accent-soft); color: var(--text-strong); }

      a { color: var(--link); text-decoration: none; transition: color .15s, opacity .15s; }
      a:hover { color: var(--accent); }
      p { margin: 0 0 1em; }
      .muted { color: var(--muted); }

      h1, h2, h3, h4 {
        font-family: var(--font-display);
        color: var(--text-strong);
        letter-spacing: -0.018em;
        line-height: 1.15;
        margin: 0 0 0.5em;
        font-weight: 600;
      }

      .container { max-width: var(--max); margin: 0 auto; padding: 0 var(--pad); }

      /* Invocation -- whisper quiet */
      .invocation {
        display: flex; align-items: center; justify-content: center; gap: 10px;
        padding: 6px 16px;
        border-bottom: 1px solid var(--rule);
        color: var(--dim);
        font-size: 0.62rem; letter-spacing: 0.35px;
      }
      .invocation .sk {
        font-family: 'Noto Sans Devanagari', serif;
        font-weight: 500; color: var(--accent);
      }
      .invocation .sk-en { font-style: italic; }
      @media (max-width: 520px) { .invocation .sk-en { display: none; } }

      /* Header */
      .site-header {
        position: sticky; top: 0; z-index: 50;
        background: var(--header-bg);
        backdrop-filter: saturate(140%) blur(12px);
        -webkit-backdrop-filter: saturate(140%) blur(12px);
        border-bottom: 1px solid var(--rule);
      }
      .header-inner {
        max-width: var(--max); margin: 0 auto;
        display: flex; align-items: center; justify-content: space-between;
        padding: 14px var(--pad);
        gap: 24px;
      }
      .brand { display: inline-flex; align-items: center; gap: 12px; color: var(--text); }
      .brand:hover { color: var(--text); }
      .brand-mark {
        display: inline-flex; align-items: center; justify-content: center;
        width: 34px; height: 34px; border-radius: 8px;
        background: var(--bg-elev);
        border: 1px solid var(--rule-strong);
        color: var(--text-strong);
        font-family: var(--font-mono);
        font-weight: 600; font-size: 0.78rem;
        letter-spacing: 0.5px;
      }
      .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
      .brand-name { font-weight: 600; font-size: 0.92rem; color: var(--text-strong); }
      .brand-role { font-size: 0.72rem; color: var(--muted); margin-top: 2px; }
      @media (max-width: 720px) { .brand-text { display: none; } }

      .primary-nav { display: flex; align-items: center; gap: 26px; }
      .primary-nav a { font-size: 0.88rem; color: var(--muted); font-weight: 500; }
      .primary-nav a:hover { color: var(--text-strong); }
      .primary-nav .nav-contact { color: var(--text-strong); }
      .primary-nav .nav-contact:hover { color: var(--accent); }
      @media (max-width: 880px) { .primary-nav { display: none; } }

      .nav-toggle {
        display: none;
        width: 36px; height: 36px;
        background: transparent; border: 1px solid var(--rule-strong);
        border-radius: 8px; padding: 9px 8px;
        flex-direction: column; justify-content: space-between;
        cursor: pointer;
      }
      .nav-toggle span { display: block; height: 1.5px; background: var(--text); border-radius: 2px; }
      @media (max-width: 880px) { .nav-toggle { display: flex; } }

      .mobile-nav {
        display: none;
        flex-direction: column;
        padding: 8px var(--pad) 18px;
        border-top: 1px solid var(--rule);
      }
      .mobile-nav.open { display: flex; }
      .mobile-nav a {
        padding: 12px 4px; color: var(--text);
        border-bottom: 1px solid var(--rule);
        font-size: 0.95rem;
      }
      .mobile-nav a:last-child { border-bottom: 0; }

      /* Footer */
      .site-footer {
        border-top: 1px solid var(--rule);
        padding: 36px 0 28px;
        margin-top: 80px;
        color: var(--muted); font-size: 0.86rem;
      }
      .footer-inner {
        display: grid; grid-template-columns: 1fr auto 1fr;
        gap: 24px; align-items: end;
      }
      .ft-name { color: var(--text-strong); font-weight: 600; font-size: 0.95rem; margin-bottom: 2px; }
      .ft-meta { font-size: 0.82rem; }
      .ft-links { display: flex; gap: 18px; justify-content: center; }
      .ft-links a { color: var(--text); }
      .ft-links a:hover { color: var(--accent); }
      .ft-copy { text-align: right; font-size: 0.82rem; }
      @media (max-width: 720px) {
        .footer-inner { grid-template-columns: 1fr; text-align: left; }
        .ft-links { justify-content: flex-start; }
        .ft-copy { text-align: left; }
      }
      .footer-mark {
        display: flex; justify-content: center;
        margin-top: 28px;
        opacity: 0.7;
      }
      .footer-mark img {
        max-width: 96px; height: auto;
        filter: grayscale(0.4) brightness(0.95)
                drop-shadow(0 6px 18px rgba(199,169,107,0.10));
        transition: opacity .25s, filter .25s, transform .35s;
      }
      html[data-theme="navy"] .footer-mark img {
        filter: drop-shadow(0 6px 18px rgba(110,168,255,0.22));
      }
      .footer-mark:hover img {
        filter: grayscale(0) brightness(1)
                drop-shadow(0 10px 24px var(--accent-soft));
        transform: translateY(-1px);
      }

      /* Theme toggle ------------------------------------------ */
      .theme-toggle {
        position: fixed;
        right: 18px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 60;
        display: inline-flex; align-items: center; gap: 8px;
        padding: 10px 14px 10px 11px;
        background: var(--header-bg);
        -webkit-backdrop-filter: saturate(140%) blur(12px);
        backdrop-filter: saturate(140%) blur(12px);
        border: 1px solid var(--rule-strong);
        border-radius: 999px;
        color: var(--text);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        cursor: pointer;
        transition: color .2s, border-color .2s, background .2s, transform .2s;
      }
      .theme-toggle:hover {
        color: var(--text-strong);
        border-color: var(--accent-rule);
        transform: translateY(-50%) translateX(-2px);
      }
      .theme-toggle .tt-icon {
        display: inline-flex; align-items: center; justify-content: center;
        width: 18px; height: 18px;
        color: var(--accent);
      }
      .tt-sun  { display: none; }
      .tt-moon { display: inline; }
      html[data-theme="navy"] .tt-moon { display: none; }
      html[data-theme="navy"] .tt-sun  { display: inline; }
      @media (max-width: 560px) {
        .theme-toggle {
          right: 12px; bottom: 14px; top: auto; transform: none;
          padding: 9px 12px;
          font-size: 0.66rem;
        }
        .theme-toggle:hover { transform: translateY(-1px); }
      }

      /* Reveal animation -- subtle */
      .reveal { opacity: 0; transform: translateY(8px); transition: opacity .55s ease, transform .55s ease; }
      .reveal.in { opacity: 1; transform: none; }
      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; transition: none; }
      }

      hr.rule { border: 0; border-top: 1px solid var(--rule); margin: 0; }
    </style>
  </body>
</html>
