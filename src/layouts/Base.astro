---
import { site } from '../config';

interface Props { title?: string; description?: string; image?: string; }
const { title, description, image } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | Infrastructure, Platforms, Operations & AI`;
const pageDesc = description ?? site.seoDescription;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://darshankansara.com').toString();
const ogImage = new URL(image ?? '/og.png', Astro.site ?? 'https://darshankansara.com').toString();
const personSchema = {
  '@context': 'https://schema.org', '@type': 'Person', name: site.name,
  url: 'https://darshankansara.com', jobTitle: site.role, email: `mailto:${site.email}`,
  worksFor: { '@type': 'Organization', name: site.org },
  sameAs: [site.linkedin, site.github],
  knowsAbout: ['Cloud Infrastructure', 'Platform Reliability', 'Data Platforms', 'Azure', 'Operations', 'Continuous Improvement', 'Artificial Intelligence'],
};
const navItems = [
  { href: '/impact', label: 'Impact' },
  { href: '/experience', label: 'Experience' },
  { href: '/ai', label: 'AI' },
  { href: '/projects', label: 'Built' },
  { href: '/writing', label: 'Writing' },
  { href: '/contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const activePath = currentPath.startsWith('/writing/')
  ? '/writing'
  : ['/lifelens', '/applyready'].includes(currentPath) || currentPath.startsWith('/projects/')
    ? '/projects'
    : currentPath;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta name="theme-color" content="#101310" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — infrastructure, platforms, operations, and applied AI`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+Devanagari:wght@500&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="invocation" aria-label="Spiritual invocation: Shree Krushna Sadaa Sahaayate">
      <span lang="sa">|| श्री कृष्ण सदा सहायते ||</span><span class="invocation-en" aria-hidden="true">Shree Krushna Sadaa Sahaayate</span>
    </div>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand" aria-label={`${site.name}, home`}>
          <span class="brand-name">Darshan <strong>Kansara</strong></span><span class="brand-context">Microsoft &middot; Redmond</span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          {navItems.map((item) => <a href={item.href} aria-current={activePath === item.href ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <button class="nav-toggle" id="navToggle" type="button" aria-label="Open navigation" aria-controls="mobileNav" aria-expanded="false"><span></span><span></span></button>
      </div>
      <nav class="mobile-nav" id="mobileNav" aria-label="Mobile navigation">
        {navItems.map((item) => <a href={item.href} aria-current={activePath === item.href ? 'page' : undefined}>{item.label}</a>)}
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-signature"><strong>Darshan Kansara</strong><span>Cloud &middot; Infrastructure &middot; Data &middot; AI</span></div>
        <div class="footer-place"><span>Microsoft</span><span>Redmond, WA</span></div>
        <nav class="footer-links" aria-label="Footer navigation"><a href="/now">Now</a><a href="/writing">Writing</a><a href={`mailto:${site.email}`}>Email</a><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">&nearr;</span></a><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">&nearr;</span></a></nav>
      </div>
      <div class="footer-bottom"><span>&copy; {new Date().getFullYear()} {site.name}</span><span>Infrastructure &middot; Datacenters &middot; Cloud &middot; Operations &middot; AI</span></div>
    </footer>
    <script>
      const setupPage = () => {
        const toggle = document.getElementById('navToggle');
        const menu = document.getElementById('mobileNav');
        if (toggle && menu) {
          const closeMenu = () => {
            menu.classList.remove('open');
            toggle.setAttribute('aria-expanded', 'false');
            toggle.setAttribute('aria-label', 'Open navigation');
          };
          toggle.addEventListener('click', () => {
            const open = menu.classList.toggle('open');
            toggle.setAttribute('aria-expanded', String(open));
            toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
          });
          menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
          document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && menu.classList.contains('open')) {
              closeMenu();
              toggle.focus();
            }
          });
        }
        if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
            if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
          }), { threshold: 0.12, rootMargin: '0px 0px -48px' });
          document.querySelectorAll('[data-reveal]').forEach((element) => observer.observe(element));
        }
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setupPage, { once: true });
      else setupPage();
    </script>
    <style is:global>
      @view-transition{navigation:auto}
      :root {
        --ink:#08111f; --ink-2:#0b1424; --ink-3:#0d1728; --paper:#f1ede3; --paper-2:#dcd7cb; --white:#fffdf7;
        --text:#e8edf3; --muted:#9ba9ba; --line:rgba(232,237,243,.14); --line-dark:rgba(232,237,243,.14);
        --azure:#4d9aeb; --azure-bright:#8fc3f7; --azure-soft:rgba(77,154,235,.14); --gold:#c6a15a;
        --max:1240px; --pad:clamp(20px,4vw,56px); --font-sans:'Instrument Sans',sans-serif; --font-display:'Newsreader',serif; --font-mono:'IBM Plex Mono',monospace;
        --bg:var(--ink); --bg-elev:var(--ink-2); --bg-deep:#090b09; --surface:rgba(233,229,218,.035); --text-strong:var(--paper);
        --platinum:#b7c3d2; --dim:#8291a5; --rule:var(--line); --rule-strong:rgba(232,237,243,.28); --accent:var(--gold);
        --accent-soft:rgba(198,161,90,.1); --accent-rule:rgba(198,161,90,.38); --link:var(--azure-bright);
        --section:clamp(76px,9vw,138px); --gutter:clamp(24px,5vw,72px); --rail:clamp(132px,16vw,206px);
      }
      *{box-sizing:border-box} html{scroll-behavior:smooth;-webkit-text-size-adjust:100%} html,body{margin:0;padding:0}
      body{min-height:100vh;background:var(--ink)!important;color:var(--text);font-family:var(--font-sans);font-size:16px;line-height:1.62;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
      body::before{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(rgba(143,195,247,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(143,195,247,.025) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(to bottom,black,transparent 78%)}
      ::selection{background:var(--azure);color:var(--ink)} a{color:inherit;text-decoration:none} img{max-width:100%} button,a{-webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible{outline:2px solid var(--azure-bright);outline-offset:4px}
      .skip-link{position:fixed;left:16px;top:-80px;z-index:100;background:var(--white);color:var(--ink);padding:10px 16px;font-weight:600}.skip-link:focus{top:12px}
      .container{width:min(var(--max),calc(100% - (var(--pad) * 2)));margin-inline:auto;padding:0} h1,h2,h3,h4{font-family:var(--font-display);color:var(--text-strong);line-height:1.02;letter-spacing:0;margin:0 0 .55em} p{margin:0 0 1em}
      .invocation{min-height:28px;display:flex;align-items:center;justify-content:center;gap:10px;background:#050b14;color:#78879a;border-bottom:1px solid var(--line);font-size:.62rem}
      .invocation [lang]{color:var(--gold);font-family:'Noto Sans Devanagari',sans-serif}.invocation-en{font-style:italic}
      .site-header{position:sticky;top:0;z-index:50;height:72px;background:rgba(8,17,31,.92);color:var(--paper);border-bottom:1px solid var(--line);backdrop-filter:blur(18px) saturate(110%)}
      .header-inner{width:min(var(--max),calc(100% - (var(--pad) * 2)));height:100%;margin-inline:auto;display:flex;align-items:center;justify-content:space-between;gap:28px}
      .brand{display:flex;align-items:baseline;gap:14px;min-width:max-content}.brand-name{font-family:var(--font-display);font-size:1.14rem;font-weight:400;letter-spacing:0}.brand-name strong{font-weight:500}.brand-context{color:#8291a5;font-family:var(--font-mono);font-size:.6rem;text-transform:uppercase}
      .primary-nav{display:flex;align-items:center;gap:clamp(18px,2.4vw,30px)}.primary-nav a{position:relative;color:#9ba9ba;font-size:.8rem;font-weight:500;transition:color .2s}.primary-nav a::after{content:"";position:absolute;left:0;right:0;bottom:-12px;height:1px;background:var(--azure);transform:scaleX(0);transform-origin:left;transition:transform .25s ease}.primary-nav a:hover,.primary-nav a:focus-visible,.primary-nav a[aria-current="page"]{color:var(--paper)}.primary-nav a[aria-current="page"]::after{transform:scaleX(1)}
      .nav-toggle{display:none;width:44px;height:44px;border:1px solid rgba(255,255,255,.2);background:transparent;color:#fff;padding:13px 10px;cursor:pointer}.nav-toggle span{display:block;height:1px;background:currentColor;margin:5px 0}
      .mobile-nav{display:none;position:absolute;top:72px;left:0;right:0;padding:8px var(--pad) 20px;background:rgba(8,17,31,.99);border-bottom:1px solid var(--line)}.mobile-nav.open{display:grid}.mobile-nav a{min-height:48px;display:flex;align-items:center;color:#cbd0c7;border-bottom:1px solid var(--line)}.mobile-nav a[aria-current="page"]{color:var(--azure-bright)}.mobile-nav a:last-child{border-bottom:0}
      .site-footer{margin:0;padding:72px var(--pad) 28px;background:#050b14;color:#929fb0;border-top:1px solid var(--line)}.footer-inner{width:min(var(--max),100%);margin-inline:auto;display:grid;grid-template-columns:1.3fr .7fr 1fr;gap:48px;align-items:end}
      .footer-signature,.footer-place{display:grid;gap:5px}.footer-signature strong{color:#fff;font-family:var(--font-display);font-size:1.15rem}.footer-signature span,.footer-place span{font-size:.8rem}.footer-links{display:flex;justify-content:flex-end;gap:22px}.footer-links a{color:#d8dfe9;font-size:.84rem}.footer-links a:hover{color:var(--azure-bright)}
      .footer-bottom{width:min(var(--max),100%);margin:52px auto 0;padding-top:20px;border-top:1px solid rgba(255,255,255,.1);display:flex;justify-content:space-between;gap:24px;color:#8d9aab;font-family:var(--font-mono);font-size:.62rem}
      [data-reveal]{opacity:1;transform:none}[data-reveal].is-visible{animation:reveal .7s cubic-bezier(.2,.7,.2,1) both}@keyframes reveal{from{opacity:.45;transform:translateY(14px)}to{opacity:1;transform:none}}
      ::view-transition-old(root){animation:180ms ease both page-out}::view-transition-new(root){animation:320ms cubic-bezier(.2,.7,.2,1) both page-in}@keyframes page-out{to{opacity:.72}}@keyframes page-in{from{opacity:0;transform:translateY(8px)}}
      main>h1,main>p,main>section:not([class]){width:min(860px,calc(100% - (var(--pad) * 2)));margin-inline:auto}main>h1{margin-top:96px;font-size:clamp(2.5rem,6vw,4.8rem)}main>h1+p{color:var(--muted);font-size:1.08rem;margin-bottom:64px}
      main>hr{width:min(860px,calc(100% - (var(--pad) * 2)));border:0;border-top:1px solid var(--line);margin:56px auto}main>section:not([class]) h2{margin-top:48px;font-size:clamp(1.5rem,3vw,2rem)}main>section:not([class]) li{margin-bottom:10px}
      .muted{color:var(--muted)}.card{display:block;padding:28px 0;border-top:1px solid var(--line)}.card:last-child{border-bottom:1px solid var(--line)}.card h3{margin-bottom:8px}.tagline{color:var(--muted)}.tags{display:flex;flex-wrap:wrap;gap:7px}.tag{padding:5px 8px;border:1px solid var(--line);color:var(--muted);font-family:var(--font-mono);font-size:.68rem}
      @media(max-width:900px){.primary-nav{display:none}.nav-toggle{display:block}.brand-context{display:none}}
      @media(max-width:720px){.invocation-en{display:none}.site-header{height:64px}.mobile-nav{top:64px}.footer-inner{grid-template-columns:1fr;gap:28px}.footer-links{justify-content:flex-start}.footer-bottom{flex-direction:column;margin-top:36px}}
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}[data-reveal].is-visible,::view-transition-old(root),::view-transition-new(root){animation:none}}
    </style>
  </body>
</html>